# API Configuration
API_PORT=8080
API_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mini_cdn

# Storage Nodes Configuration
# For single-node local development:
STORAGE_LOCAL_URL=http://localhost:8081

# For multi-node distributed simulation (optional / later):
# STORAGE_SINGAPORE_URL=http://localhost:8081
# STORAGE_NEWYORK_URL=http://localhost:8082
# STORAGE_LONDON_URL=http://localhost:8083

# Maximum upload size in megabytes (default 100MB)
MAX_UPLOAD_SIZE_MB=100
