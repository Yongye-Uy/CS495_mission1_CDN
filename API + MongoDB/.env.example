# Central API Configuration
API_PORT=8080
API_ENV=production

# MongoDB 7.0 (Standalone Database)
MONGO_URI=mongodb://localhost:27017/cdn_metadata
MONGO_DB=cdn_metadata

# Storage SSH Authentication Paths
SSH_KEY_PATH=/home/ubuntu/.ssh/storage_key
KNOWN_HOSTS_PATH=/home/ubuntu/.ssh/cdn_known_hosts
SSH_USER=ubuntu
STORAGE_DATA_DIR=/var/cdn/data

# Administrator Secret Key for Node Mutations
ADMIN_API_KEY=admin_secret_key_12345

# Maximum upload size in megabytes (default 100MB)
MAX_UPLOAD_SIZE_MB=100
