# Website Frontend Configuration
WEBSITE_PORT=3000

# Central API URL (Server #2 IP address)
# If using Apache reverse proxy on Server #2: http://<API_SERVER_IP>
API_BASE_URL=http://localhost:8080

# Administrator Secret Key (Must match ADMIN_API_KEY on API Server #2)
CENTRAL_API_ADMIN_KEY=admin_secret_key_12345
